# Database (SQLite default for zero-setup local dev, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://username:password@localhost:5432/crissresidence?schema=public"

# Admin Authentication Secret (Generate a 32+ char random string in production)
JWT_SECRET="your-super-secret-jwt-key"

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@crissresidence.ro"

# Optional Email Delivery (Resend / SMTP)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Criss Residence <contact@crissresidence.ro>"
